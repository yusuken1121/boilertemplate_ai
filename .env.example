# ---------------------------------------------------------------------------
# Public app metadata (inlined into the client bundle at build time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Next.js Boilerplate"
NEXT_PUBLIC_APP_DESCRIPTION="Clean Architecture starter for the Next.js App Router"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# Which IAIGateway implementation the Chat feature uses: "gemini" | "anthropic"
NEXT_PUBLIC_CHAT_PROVIDER="gemini"

# ---------------------------------------------------------------------------
# Server secrets — validated lazily, per key, in src/lib/env.ts.
# Only the features you actually use need to be filled in.
# ---------------------------------------------------------------------------

# Auth — required to sign in. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Database — matches docker-compose.yml. Run `docker compose up -d` first.
DATABASE_URL="postgresql://app:app@localhost:5432/app"

# Chat feature — whichever provider NEXT_PUBLIC_CHAT_PROVIDER selects
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Contact feature — Notion (POST /api/contact)
NOTION_TOKEN=
NOTION_CONTACT_DATABASE_ID=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# First account created by `pnpm db:seed`
# SEED_EMAIL="admin@example.com"
# SEED_PASSWORD="changeme123"
# SEED_NAME="Admin"

# Postgres pool size per instance (default 5)
# DATABASE_POOL_MAX=5

# Client HTTP base URL — empty means "same origin"
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_MOCK_API_URL=
