# ---------------------------------------------------------------------------
# Public app metadata (inlined into the client bundle at build time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Next.js Boilerplate"
NEXT_PUBLIC_APP_DESCRIPTION="Clean Architecture starter for the Next.js App Router"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# ---------------------------------------------------------------------------
# Server secrets — validated lazily in src/lib/env.ts.
# Only the features you actually use need to be filled in.
# ---------------------------------------------------------------------------

# Google Gemini — required by the Chat feature (POST /api/chat)
GEMINI_API_KEY=

# Notion — required by the Contact feature (POST /api/contact)
NOTION_TOKEN=
NOTION_CONTACT_DATABASE_ID=

# ---------------------------------------------------------------------------
# Client HTTP base URL (optional — empty means "same origin")
# Set NEXT_PUBLIC_USE_MOCK=true to route every client call to a mock server.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_MOCK_API_URL=
